<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResultadosTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resultados"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTerminoPena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvProgressaoRegime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLivramentoCondicional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etNomeCompleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nome_completo"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/numero_whatsapp"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/etNumeroProcesso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/numero_processo"
            android:inputType="text" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voltar"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnSalvarEnviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salvar_enviar"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnFalarAdvogado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/falar_advogado"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
